{% extends "layouts/base.njk" %}

{% set categoryObj = categories | categoryBySlug(category) %}
{% set typeLabel = { review: "商品レビュー", comparison: "比較記事", ranking: "ランキング" }[type] %}
{% set typeUrl = { review: "/reviews/", comparison: "/comparisons/", ranking: "/rankings/" }[type] %}
{% set breadcrumbs = [ { name: "トップ", url: "/" }, { name: typeLabel, url: typeUrl } ] %}
{% if categoryObj %}
{% set breadcrumbs = breadcrumbs.concat([{ name: categoryObj.name, url: "/category/" + categoryObj.slug + "/" }]) %}
{% endif %}
{% set breadcrumbs = breadcrumbs.concat([{ name: title, url: null }]) %}

{% block head %}
{% include "schema/breadcrumb.njk" %}
{% if type == "review" %}
{% include "schema/product-review.njk" %}
{% else %}
{% include "schema/item-list.njk" %}
{% endif %}
{% endblock %}

{% block content %}
<div class="wrap">
  {% include "partials/breadcrumbs.njk" %}
  <article class="prose article-content">
    <header class="article-header">
      <p class="article-meta-type">{{ typeLabel }}</p>
      <h1>{{ title }}</h1>
      <p class="article-dates">
        公開日: <time datetime="{{ publishDate }}">{{ publishDate | dateDisplay }}</time>
        {%- if updateDate and updateDate != publishDate %} ／ 更新日: <time datetime="{{ updateDate }}">{{ updateDate | dateDisplay }}</time>{% endif %}
      </p>
      {%- if tags and tags.length %}
      <ul class="article-tags">
        {%- for tag in tags %}<li><a href="/tag/{{ tag }}/">#{{ tag }}</a></li>{% endfor %}
      </ul>
      {%- endif %}
    </header>

    {%- if product %}
    {% include "partials/amazon-button.njk" %}
    {%- endif %}

    {{ content | safe }}

    {%- if items and items.length %}
    <div class="comparison-items">
      {%- for entry in items %}
      <div class="comparison-item">
        <h3>{% if entry.rank %}{{ entry.rank }}位：{% endif %}{{ entry.name }}</h3>
        {% set product = entry %}
        {% include "partials/amazon-button.njk" %}
        {%- if entry.pros %}
        <div class="pros-cons">
          <div><h4>良い点</h4><ul>{% for p in entry.pros %}<li>{{ p }}</li>{% endfor %}</ul></div>
          {%- if entry.cons %}<div><h4>気になる点</h4><ul>{% for c in entry.cons %}<li>{{ c }}</li>{% endfor %}</ul></div>{% endif %}
        </div>
        {%- endif %}
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
  </article>

  {% include "partials/related-articles.njk" %}
</div>
{% endblock %}
