{%- set currentRef = { category: category, tags: tags, page: { url: page.url } } %}
{%- set related = collections.articles | relatedArticles(currentRef, 4) %}
{%- if related.length %}
<section class="related-articles" aria-labelledby="related-heading">
  <h2 id="related-heading">関連記事</h2>
  <div class="article-grid">
    {%- for item in related %}
    {% include "partials/article-card.njk" %}
    {%- endfor %}
  </div>
</section>
{%- endif %}
