<div class="product-box">
  {%- if product.image %}
  <img class="product-box-image" src="{{ product.image }}" alt="{{ product.name }}" width="240" height="240" loading="lazy">
  {%- endif %}
  <div class="product-box-body">
    <p class="product-box-name">{{ product.name }}</p>
    {%- if product.rating %}
    <p class="product-box-rating" aria-label="評価 {{ product.rating }} / 5">{{ product.rating | stars }} <span>{{ product.rating }}</span></p>
    {%- endif %}
    {%- if product.price %}
    <p class="product-box-price">¥{{ product.price | formatPrice }}</p>
    {%- endif %}
    <a class="amazon-button" href="{{ product.asin | amazonUrl }}" rel="sponsored noopener" target="_blank">
      Amazonで見る
    </a>
  </div>
</div>
