---
title: ""
description: ""
permalink: "/index.html"
---
{% extends "layouts/base.njk" %}
{% block head %}
{% include "schema/website.njk" %}
{% include "schema/organization.njk" %}
{% endblock %}
{% block content %}
<section class="hero">
  <div class="wrap">
    <h1>{{ site.name }}</h1>
    <p class="hero-lead">{{ site.description }}</p>
    <form class="hero-search" action="/search/" method="get">
      <input type="search" name="q" placeholder="商品名やキーワードで探す" aria-label="サイト内検索">
      <button type="submit">検索</button>
    </form>
  </div>
</section>

<section class="wrap">
  <h2>カテゴリから探す</h2>
  <ul class="category-grid">
    {%- for cat in categories %}
    <li class="category-card">
      <a href="/category/{{ cat.slug }}/">
        <h3>{{ cat.name }}</h3>
        <p>{{ cat.description }}</p>
      </a>
    </li>
    {%- endfor %}
  </ul>
</section>

<section class="wrap">
  <h2>新着記事</h2>
  <div class="article-grid">
    {%- for item in collections.articles | limit(8) %}
    {% include "partials/article-card.njk" %}
    {%- endfor %}
  </div>
</section>
{% endblock %}
